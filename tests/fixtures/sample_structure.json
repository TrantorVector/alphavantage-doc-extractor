      "name": "Stock Time Series Data",
      "description": "Endpoints for retrieving historical stock price data with various intervals and formats.",
      "endpoints": [
        {
          "function_name": "TIME_SERIES_INTRADAY",
          "description": "Returns intraday time series data for a given stock symbol with 1-minute, 5-minute, 15-minute, 30-minute, or 60-minute intervals.",
          "required_params": [
            {
              "name": "function",
              "value_type": "string",
              "description": "The API function to call",
              "default": null,
              "options": []
            },
            {
              "name": "symbol",
              "value_type": "string",
              "description": "The stock symbol to retrieve data for",
              "default": null,
              "options": []
            },
            {
              "name": "apikey",
              "value_type": "string",
              "description": "Your API key",
              "default": null,
              "options": []
            }
          ],
          "optional_params": [
            {
              "name": "interval",
              "value_type": "string",
              "description": "Time interval between data points",
              "default": "5min",
              "options": ["1min", "5min", "15min", "30min", "60min"]
            },
            {
              "name": "outputsize",
              "value_type": "string",
              "description": "The size of the output",
              "default": "compact",
              "options": ["compact", "full"]
            }
          ],
          "request_pattern": "https://www.alphavantage.co/query?function=TIME_SERIES_INTRADAY&symbol={symbol}&interval={interval}&outputsize={outputsize}&apikey={apikey}",
          "python_example": {
            "language": "python",
            "code": "import requests\n\nurl = 'https://www.alphavantage.co/query?function=TIME_SERIES_INTRADAY&symbol=IBM&interval=5min&apikey=demo'\nr = requests.get(url)\ndata = r.json()\nprint(data)"
          },
          "premium_only": false
        },
